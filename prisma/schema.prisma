// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  university String
  faculty   String
  role      String     @default("student") // "student", "professor", "assistant", "ct"
  isAdmin   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relations
  documents Document[]
  purchases Purchase[]
  comments  Comment[]
}

model Document {
  id          String     @id @default(cuid())
  title       String
  description String?
  author      String
  faculty     String
  category    String     // "Syllabus", "Notes", "Exercices", "Ouvrage"
  price       Float      @default(0)
  fileUrl     String?
  imageUrl    String?
  downloads   Int        @default(0)
  likes       Int        @default(0)
  dislikes    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Relations
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  comments    Comment[]
  likes_list  UserLike[]
}

model Purchase {
  id          String     @id @default(cuid())
  userId      String
  documentId  String
  amount      Float
  status      String     @default("completed") // "pending", "completed", "failed"
  createdAt   DateTime   @default(now())
  
  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Comment {
  id          String     @id @default(cuid())
  content     String
  userId      String
  documentId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model UserLike {
  id          String     @id @default(cuid())
  userId      String
  documentId  String
  type        String     // "like" or "dislike"
  createdAt   DateTime   @default(now())
  
  // Relations
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@unique([userId, documentId])
}
